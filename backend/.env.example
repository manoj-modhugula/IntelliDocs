# IntelliDocs Environment Variables

# ===================
# Application
# ===================
DEBUG=true
ENVIRONMENT=development

# JWT Auth (auto-generated if not set - required for production)
# JWT_SECRET_KEY=your-secure-secret-key-here

# ===================
# Database (Neon PostgreSQL)
# ===================
DATABASE_URL=postgresql://user:password@host.neon.tech/intellidocs?sslmode=require

# ===================
# Redis
# Use Upstash REST in hosted environments, or REDIS_URL for local Redis.
# ===================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379/0

# ===================
# LLM Provider Configuration
# ===================
# Options: bedrock, nvidia, openai, anthropic
LLM_PROVIDER=bedrock

# NVIDIA API Configuration (when LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Popular models: moonshotai/kimi-k2.5, nvidia/llama-3.1-nemotron-70b-instruct, meta/llama-3.1-405b-instruct
NVIDIA_MODEL_ID=moonshotai/kimi-k2.5

# OpenAI Configuration (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ===================
# AWS Credentials (when LLM_PROVIDER=bedrock)
# ===================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ===================
# File storage (originals for the source viewer)
# local = disk under LOCAL_STORAGE_DIR (default)
# s3 = AWS S3 using S3_BUCKET_NAME
# ===================
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/documents
S3_BUCKET_NAME=intellidocs-documents

# ===================
# AWS Bedrock Model IDs
# ===================
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_AUX_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ===================
# RAG Configuration (must match app/core/config.py defaults)
# ===================
CHUNK_SIZE=300
CHUNK_OVERLAP=75
TOP_K_RESULTS=12
SEMANTIC_WEIGHT=0.7
ENABLE_HYDE=true
ENABLE_RERANKER=true
ENABLE_MULTI_QUERY=true
ENABLE_STRUCTURED_CHUNKS=true
ENABLE_CLIP=true
ENABLE_NLI_FILTER=true
ENABLE_IDENTIFIER_SEARCH=true
VISUAL_RRF_WEIGHT=0.7
# Metric runs: EVAL_REAL_ENCODERS=true, MOCK_LLM_AND_EMBEDDINGS=false, ENABLE_IDENTIFIER_SEARCH=false
# EVAL_DENSE_MODEL=BAAI/bge-small-en-v1.5
# EVAL_VISION_MODEL=clip-ViT-B-32
# NLI_BACKEND=auto

# ===================
# Caching
# ===================
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.95

# ===================
# Mock Mode (for testing without API calls)
# ===================
# MOCK_LLM_AND_EMBEDDINGS=true
