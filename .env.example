# IntelliDocs Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Application
# ===================
DEBUG=true

# JWT Auth (required in production - use a secure random 32+ char string)
JWT_SECRET_KEY=your-secure-random-secret-key-min-32-chars

# ===================
# Database (Neon PostgreSQL)
# ===================
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
# Set true only if you must disable SSL verification (not recommended)
DB_SSL_INSECURE=false

# ===================
# Redis (Upstash)
# ===================
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# ===================
# AWS Credentials
# ===================
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-1

# ===================
# AWS S3
# ===================
S3_BUCKET_NAME=intellidocs-documents

# ===================
# AWS Bedrock (real Nova Pro + Titan embeddings)
# ===================
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Set true for local dev: instant processing (no Bedrock calls, no AWS charges)
# MOCK_LLM_AND_EMBEDDINGS=true

# Faster embedding (defaults: RPS=6, concurrency=8; lower if throttled)
# EMBEDDING_RPS=6
# EMBEDDING_MAX_CONCURRENCY=8

# ===================
# RAG Configuration
# ===================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=10

# ===================
# Caching
# ===================
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
